# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/tennis_tournaments?retryWrites=true&w=majority
# Admin login (the only account that can edit anything)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase
# Long random string used to sign login tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-random-hex
PORT=3000
# Optional: if startup fails with "querySrv ECONNREFUSED", use public DNS for the Atlas lookup
# DNS_SERVERS=8.8.8.8,1.1.1.1
